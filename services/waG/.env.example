# Production requires secrets and Meta WhatsApp Business Cloud API setup.
# Never commit the populated .env file. Restrict it to its owner (chmod 600).

PORT=3000
APP_NAME="RideOn Indonesia"
APP_ENV=production
GATEWAY_SECRET=replace-with-at-least-32-random-bytes
CONFIG_FILE=./storage/runtime.env

# Official WhatsApp Business Cloud API
WHATSAPP_MODE=cloud
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_OTP_LANGUAGE=id
# Approved Meta AUTHENTICATION templates with OTP button. The code is sent in
# the body and button; configure any displayed expiry to match OTP_EXPIRY_MINUTES.
WHATSAPP_OTP_TEMPLATE_DEFAULT=
WHATSAPP_OTP_TEMPLATE_RESET=

# Create a bcrypt hash with cost 10-14; do not use a default password.
DASHBOARD_PASSWORD_DEFAULT=
ADMIN_PASSWORD_HASH=

SESSION_DB_PATH=./storage/whatsapp.db
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60
OTP_TEMPLATE_DEFAULT="*{{app_name}}*\n\nHalo! Kode verifikasi Anda adalah:\n\n*{{code}}*\n\nKode ini berlaku selama {{expiry_minutes}} menit. Jangan berikan kode ini kepada siapa pun."
OTP_TEMPLATE_RESET="*{{app_name}}*\n\nKode untuk mengatur ulang kata sandi Anda:\n\n*{{code}}*\n\nKode ini berlaku selama {{expiry_minutes}} menit. Jangan berikan kode ini kepada siapa pun."

# AI is disabled until a provider and retention/privacy terms are configured.
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_FALLBACK_MESSAGE="Mohon maaf, asisten kami sedang tidak tersedia. Tim kami akan menindaklanjuti pesan Anda."
AI_KNOWLEDGE_BASE_PATH=./knowledge_base.md
AI_MAX_CONTEXT_TURNS=8
AI_CONTEXT_TTL_MINUTES=30
AI_DEBOUNCE_SECONDS=2.5
AI_HUMAN_TAKEOVER_ENABLED=true
AI_HUMAN_TAKEOVER_MINUTES=30
AI_TYPING_DELAY_ENABLED=false
AI_TYPING_DELAY_VALUE=0
AI_TYPING_DELAY_UNIT=ms
AI_RESPONSE_TEMPLATE={{reply}}

# Optional external webhook; production requires HTTPS.
WEBHOOK_URL=
CORS_ALLOWED_ORIGINS=
TRUSTED_PROXY_CIDRS=
