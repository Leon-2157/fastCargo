# Admin dashboard — hanya dari loopback / jaringan bridge Podman (cloudflared) atau VPN internal
server {
    listen 80;
    server_name ${NGINX_ADMIN_HOSTS};

    allow 127.0.0.1/32;
    allow ::1;
    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    deny all;

    include /etc/nginx/snippets/php-laravel.conf;
}

